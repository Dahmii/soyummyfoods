# Public Supabase browser configuration. These values are safe to expose to the browser.
# Never add a service-role key, database password, payment secret, or webhook secret here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# Stripe browser mode and publishable key only. Never add Stripe secret or webhook keys to Vite variables.
# This mode must match the Supabase Edge Function STRIPE_MODE exactly.
VITE_STRIPE_MODE=test
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Configure STRIPE_MODE=test separately as a Supabase Edge secret for current
# development/preview deployments. Production will deliberately use
# VITE_STRIPE_MODE=live and STRIPE_MODE=live with matching live Stripe keys.
